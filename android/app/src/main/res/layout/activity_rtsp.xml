<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/connectionPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="PhoneCam"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="Your phone. Your computer. One camera."
            android:textColor="#AAFFFFFF"
            android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open PhoneCam Receiver on your computer, then find it below."
            android:textColor="#FFFFFFFF" android:textSize="16sp" android:paddingBottom="12dp" />
        <Button android:id="@+id/findComputerBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find my computer" />
        <TextView android:id="@+id/easyConnectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Use the same home network. Allow local-network access when asked."
            android:textColor="#FFCBD5E1" android:padding="12dp" />
        <EditText android:id="@+id/receiverCodeEdit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="PC code or computer IP address" android:inputType="textNoSuggestions" android:singleLine="true"
            android:textColor="#FFFFFFFF" android:textColorHint="#FF94A3B8" android:minHeight="48dp" />
        <Button android:id="@+id/connectComputerBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Connect with code" />
        <Button android:id="@+id/stopComputerBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stop connection" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selecting a computer starts your camera. Streaming stops when you leave this app."
            android:textColor="#FF94A3B8" android:padding="12dp" />
        <Button android:id="@+id/advancedConnectionBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Advanced connection options" />
        <LinearLayout android:id="@+id/advancedConnectionPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Receiver URL"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rtspUrlText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FF1F2933"
            android:padding="12dp"
            android:text="@string/default_rtsp_url"
            android:textColor="#FF9CDCFE"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Pairing Code"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pairingCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#FF111827"
            android:padding="12dp"
            android:text="000000"
            android:textAlignment="center"
            android:textColor="#FFE5E7EB"
            android:textIsSelectable="true"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Connection Quality"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/profileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/profileEfficient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:text="Efficient"
                android:textColor="#FFFFFFFF" />

            <RadioButton
                android:id="@+id/profileBalanced"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:text="Balanced"
                android:textColor="#FFFFFFFF" />

            <RadioButton
                android:id="@+id/profileMotion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FFFFFFFF"
                android:text="Motion"
                android:textColor="#FFFFFFFF" />
        </RadioGroup>

        <TextView
            android:id="@+id/profileSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Efficient: 960x540 @ 30 fps, 1.2 Mbps"
            android:textAlignment="center"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="Start Camera Server"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textAlignment="center"
            android:textColor="#AAFFFFFF"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="High resolution and high frame rate"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/stream4kCapabilityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FF1F2933"
            android:padding="12dp"
            android:text="Checking camera and encoder modes..."
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/streamModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="Camera resolution and frame rate" />

        <CheckBox
            android:id="@+id/remoteCameraControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow a receiver on this network to start the camera while this screen is open"
            android:textColor="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/stream4kTargetIpEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#FF1F2933"
                android:hint="Receiver IP"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#FF9CDCFE"
                android:textColorHint="#66FFFFFF"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/stream4kTargetPortEdit"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:background="#FF1F2933"
                android:hint="Port"
                android:inputType="number"
                android:padding="12dp"
                android:text="5004"
                android:textColor="#FF9CDCFE"
                android:textColorHint="#66FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/stream4kToggleBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="12dp"
            android:text="Start camera stream"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/stream4kStatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4K UDP idle. Control port: 47822."
            android:textAlignment="center"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/previewPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <SurfaceView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/previewBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="#AA111827"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="PREVIEW STARTING"
            android:textColor="#FFFBBF24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/streamHeadlineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="58dp"
            android:layout_marginEnd="88dp"
            android:background="#55000000"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="520dp"
            android:padding="10dp"
            android:text="Preview: starting"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/diagnosticsToggleBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:minWidth="64dp"
            android:text="Info" />

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="122dp"
            android:layout_marginEnd="16dp"
            android:background="#99000000"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/streamStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Streaming"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Zoom: 1.0x"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/switchCameraBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:text="Switch" />

            <Button
                android:id="@+id/rotateCounterClockwiseBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:text="Rotate Left" />

            <Button
                android:id="@+id/rotateStreamBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:text="Rotate Right" />

            <Button
                android:id="@+id/disconnectBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="1"
                android:textSize="12sp"
                android:text="Stop" />
        </LinearLayout>

        <View
            android:id="@+id/blackoutOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
